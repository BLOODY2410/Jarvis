GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-20b
JARVIS_MAX_TOOL_ROUNDS=8
JARVIS_TTS_ENABLED=true
JARVIS_TTS_URL=http://127.0.0.1:8765
# auto: Fish Audio primary, local Piper fallback. Use piper for fully offline TTS.
JARVIS_TTS_PROVIDER=auto
FISH_AUDIO_API_KEY=replace_me
FISH_AUDIO_REFERENCE_ID=replace_with_voice_model_id
# Free access is currently documented through 2026-08-31; s2-pro is the official API fallback.
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_FALLBACK_MODEL=s2-pro
FISH_AUDIO_TTS_URL=https://api.fish.audio/v1/tts
FISH_AUDIO_LATENCY=low
FISH_AUDIO_SPEED=0.97
FISH_AUDIO_CONNECT_TIMEOUT_SECS=2.5
FISH_AUDIO_READ_TIMEOUT_SECS=12
FISH_AUDIO_RETRIES=1
FISH_AUDIO_RETRY_DELAY_SECS=0.25
FISH_AUDIO_FX_ENABLED=false
FISH_AUDIO_ALLOW_PAID_FALLBACK=false
JARVIS_TTS_CACHE_MAX_CHARS=120
JARVIS_VOICE_INPUT_ENABLED=true
JARVIS_VOICE_INPUT_URL=http://127.0.0.1:8766
JARVIS_CONVERSATION_TIMEOUT_SECS=60
JARVIS_PROFILE=production
# Короткі фрази йдуть через turbo; довгі або fallback — через large-v3.
JARVIS_FAST_WHISPER_MODEL=whisper-large-v3-turbo
JARVIS_WHISPER_MODEL=whisper-large-v3
JARVIS_FAST_STT_MAX_SPEECH_MS=3500
JARVIS_STT_LANGUAGE=uk
JARVIS_MIC_DEVICE=
JARVIS_ACTIVATION_MODE=hybrid
JARVIS_HOTKEY_ENABLED=true
JARVIS_WAKE_THRESHOLD=0.45
JARVIS_WAKE_VARIANTS=джарвіс,джарвис,джарвиз
JARVIS_WAKE_VOSK_MAX_EDIT_DISTANCE=1
JARVIS_VAD_AGGRESSIVENESS=1
JARVIS_VAD_ENERGY_RATIO=1.10
JARVIS_VAD_ENERGY_DELTA=0.004
JARVIS_VAD_START_CHUNKS=2
JARVIS_VAD_RESUME_CHUNKS=2
# Для короткої команди: 440 мс; після 3 с мовлення адаптивно: 1200 мс.
JARVIS_FAST_END_SILENCE_MS=440
JARVIS_LONG_UTTERANCE_THRESHOLD_MS=3000
JARVIS_END_SILENCE_MS=1200
JARVIS_MAX_UTTERANCE_SECS=20
JARVIS_BARGE_IN_CHUNKS=3
JARVIS_BARGE_IN_ENABLED=false
JARVIS_MIN_SPEECH_MS=300
JARVIS_MIN_AUDIO_RMS=0.0015
JARVIS_POST_TTS_GUARD_MS=200
JARVIS_PRE_ROLL_MS=480
JARVIS_POST_ROLL_MS=240
JARVIS_DIAGNOSTIC=false
JARVIS_LEVEL_LOG_INTERVAL_MS=1000
JARVIS_STT_RESPONSE_FORMAT=json
JARVIS_STT_PROMPT=Українська голосова команда для персонального асистента Джарвіс.
JARVIS_INPUT_LOG_LEVEL=WARNING
# Local Piper fallback settings
JARVIS_TTS_MODE=jarvis_reference
JARVIS_TTS_SPEED=1.03
JARVIS_TTS_SAMPLE_RATE=native
JARVIS_FX_ENABLED=true
JARVIS_FX_PITCH_SEMITONES=-1.10
JARVIS_FX_FORMANT_SHIFT_SEMITONES=-0.70
JARVIS_FX_PRESERVE_FORMANTS=true
JARVIS_FX_LOW_SHELF_DB=2.4
JARVIS_FX_WARMTH_DB=1.4
JARVIS_FX_BOXINESS_DB=-2.2
JARVIS_FX_PRESENCE_DB=2.3
JARVIS_FX_AIR_DB=0.8
JARVIS_FX_COMPRESSOR_THRESHOLD_DB=-21.0
JARVIS_FX_COMPRESSOR_RATIO=3.0
JARVIS_FX_SATURATION_DRIVE_DB=3.0
JARVIS_FX_SATURATION_MIX=0.08
JARVIS_FX_REVERB_ROOM_SIZE=0.10
JARVIS_FX_REVERB_WET_LEVEL=0.035
JARVIS_FX_SPATIAL_DELAY_MS=7.0
JARVIS_FX_SPATIAL_WIDTH=0.12
JARVIS_FX_OUTPUT_GAIN_DB=-1.2
