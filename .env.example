GROQ_API_KEY=replace_me
GROQ_MODEL=openai/gpt-oss-20b
JARVIS_MAX_TOOL_ROUNDS=8
JARVIS_TTS_ENABLED=true
JARVIS_TTS_URL=http://127.0.0.1:8765
JARVIS_VOICE_INPUT_ENABLED=true
JARVIS_VOICE_INPUT_URL=http://127.0.0.1:8766
JARVIS_CONVERSATION_TIMEOUT_SECS=25
JARVIS_WHISPER_MODEL=whisper-large-v3
JARVIS_STT_LANGUAGE=uk
JARVIS_MIC_DEVICE=
JARVIS_WAKE_THRESHOLD=0.45
JARVIS_WAKE_VARIANTS=джарвіс,джарвис,джарвиз
JARVIS_VAD_AGGRESSIVENESS=2
JARVIS_VAD_ENERGY_RATIO=1.20
JARVIS_VAD_ENERGY_DELTA=0.012
JARVIS_VAD_START_CHUNKS=2
JARVIS_END_SILENCE_MS=1400
JARVIS_MAX_UTTERANCE_SECS=20
JARVIS_BARGE_IN_CHUNKS=3
JARVIS_BARGE_IN_ENABLED=false
JARVIS_MIN_SPEECH_MS=450
JARVIS_MIN_AUDIO_RMS=0.0025
JARVIS_POST_TTS_GUARD_MS=650
JARVIS_PRE_ROLL_MS=400
JARVIS_POST_ROLL_MS=320
JARVIS_DIAGNOSTIC=false
JARVIS_LEVEL_LOG_INTERVAL_MS=1000
JARVIS_STT_RESPONSE_FORMAT=verbose_json
JARVIS_STT_PROMPT=Українська голосова команда для персонального асистента Джарвіс.
JARVIS_INPUT_LOG_LEVEL=INFO
# Voice sidecar settings (set these in the shell that starts voice_service)
JARVIS_TTS_MODE=jarvis_reference
JARVIS_TTS_SPEED=1.03
JARVIS_TTS_SAMPLE_RATE=native
JARVIS_FX_ENABLED=true
JARVIS_FX_PITCH_SEMITONES=-1.10
JARVIS_FX_FORMANT_SHIFT_SEMITONES=-0.70
JARVIS_FX_PRESERVE_FORMANTS=true
JARVIS_FX_LOW_SHELF_DB=2.4
JARVIS_FX_WARMTH_DB=1.4
JARVIS_FX_BOXINESS_DB=-2.2
JARVIS_FX_PRESENCE_DB=2.3
JARVIS_FX_AIR_DB=0.8
JARVIS_FX_COMPRESSOR_THRESHOLD_DB=-21.0
JARVIS_FX_COMPRESSOR_RATIO=3.0
JARVIS_FX_SATURATION_DRIVE_DB=3.0
JARVIS_FX_SATURATION_MIX=0.08
JARVIS_FX_REVERB_ROOM_SIZE=0.10
JARVIS_FX_REVERB_WET_LEVEL=0.035
JARVIS_FX_SPATIAL_DELAY_MS=7.0
JARVIS_FX_SPATIAL_WIDTH=0.12
JARVIS_FX_OUTPUT_GAIN_DB=-1.2
