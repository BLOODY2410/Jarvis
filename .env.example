# Required for the primary voice/vision/tool session.
GEMINI_API_KEY=

# Optional emergency text/STT fallback. It is never selected ahead of Gemini.
GROQ_API_KEY=

# Optional Fish voice mode. Leave both blank to use Gemini native Live audio.
FISH_API_KEY=
FISH_VOICE_ID=

JARVIS_WAKE_WORD=джарвіс
JARVIS_WAKE_VARIANTS=джарвіс,джарвис,джарвиз,jarvis
JARVIS_VOICE_MODE=gemini
JARVIS_FALLBACK_ENABLED=true
JARVIS_DEBUG=false

# Extended Thinking is selected only for explicitly complex workflows.
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_EXTENDED_MODEL=gemini-3.8-live-extended-thinking
GEMINI_TEXT_MODEL=gemini-3.8-flash
GROQ_MODEL=openai/gpt-oss-120b

JARVIS_CONVERSATION_TIMEOUT_SECS=45
JARVIS_REQUEST_TIMEOUT_MS=3500
JARVIS_LIVE_TIMEOUT_MS=7000
JARVIS_CIRCUIT_FAILURES=1
JARVIS_CIRCUIT_COOLDOWN_SECS=90
JARVIS_VOICE_MAX_CHARS=280
JARVIS_VOICE_MAX_SENTENCES=2
JARVIS_CUSTOM_VOCABULARY=Джарвіс,YouTube,YouTube Music,Steam,Discord,Telegram,Chrome,Visual Studio Code
